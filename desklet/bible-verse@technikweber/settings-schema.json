{
    "head-content": {
        "type": "header",
        "description": "Content"
    },
    "source": {
        "type": "combobox",
        "default": "curated",
        "description": "Source",
        "options": {
            "Curated verse list (offline)": "curated",
            "Herrnhuter Losungen": "losungen"
        },
        "tooltip": "The Losungen are free for non-commercial use only and are not shipped with this desklet. Download the year file from losungen.de and import it with tools/import_losungen.py."
    },
    "losungen-file": {
        "type": "filechooser",
        "default": "",
        "description": "Losungen year file",
        "tooltip": "The ZIP or XML you downloaded from losungen.de.",
        "dependency": "source=losungen"
    },
    "losungen-import": {
        "type": "button",
        "description": "Import the selected file",
        "callback": "onImportLosungen",
        "dependency": "source=losungen"
    },
    "losungen-status": {
        "type": "label",
        "description": "The Losungen are free for non-commercial use only and are not shipped with this desklet. Download the year file from losungen.de, select it above and import it. Repeat once a year.",
        "dependency": "source=losungen"
    },
    "language": {
        "type": "combobox",
        "default": "auto",
        "description": "Translation",
        "options": {
            "Follow system language": "auto",
            "German — Lutherbibel 1912": "de",
            "English — World English Bible": "en",
            "Spanish — Reina-Valera 1909": "es"
        },
        "dependency": "source=curated"
    },
    "show-reference": {
        "type": "checkbox",
        "default": true,
        "description": "Show book, chapter and verse"
    },
    "head-size": {
        "type": "header",
        "description": "Size"
    },
    "width": {
        "type": "spinbutton",
        "default": 380,
        "min": 160,
        "max": 1600,
        "step": 10,
        "units": "pixels",
        "description": "Width"
    },
    "font-size": {
        "type": "spinbutton",
        "default": 16,
        "min": 6,
        "max": 96,
        "step": 1,
        "units": "points",
        "description": "Text size"
    },
    "head-appearance": {
        "type": "header",
        "description": "Appearance"
    },
    "font-family": {
        "type": "entry",
        "default": "",
        "description": "Font family",
        "tooltip": "Leave empty to use the desktop font."
    },
    "italic": {
        "type": "checkbox",
        "default": false,
        "description": "Italic"
    },
    "centered": {
        "type": "checkbox",
        "default": true,
        "description": "Centre the text"
    },
    "text-color": {
        "type": "colorchooser",
        "default": "rgb(255,255,255)",
        "description": "Text colour"
    },
    "shadow": {
        "type": "checkbox",
        "default": true,
        "description": "Shadow behind the text",
        "tooltip": "Keeps the text readable on a bright wallpaper."
    }
}
